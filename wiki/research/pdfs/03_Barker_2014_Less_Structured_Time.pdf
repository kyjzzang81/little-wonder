         <dc:format>application/pdf</dc:format>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Less-structured time in children's daily lives predicts self-directed executive functioning</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>Jane E. Barker</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Executive functions (EFs) in childhood predict important life outcomes.</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:subject>
            <rdf:Bag>
               <rdf:li>cognitive development</rdf:li>
               <rdf:li>self-directed executive function</rdf:li>
               <rdf:li>leisure time</rdf:li>
